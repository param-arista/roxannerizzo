{% comment %}
  "You may also like": Shopify's related-product recommendations, loaded
  after the page when the section scrolls near (product.js), and shown in
  the same product row as the home page's "Explore favorites".
{% endcomment %}

{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer></script>

{%- liquid
  assign heading_id = 'RecommendationsHeading-' | append: section.id
  assign columns = section.settings.columns
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '10 / 7'
    else
      assign ratio = '5 / 4'
  endcase
-%}

<product-recommendations
  class="section featured-products featured-products--{{ section.settings.width | default: 'contained' }} card-fit--{{ section.settings.image_fit | default: 'cover' }}{% if columns >= 4 %} featured-products--many{% endif %}{% if section.settings.alt_background %} section--alt{% endif %}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ columns }}&intent=related"
  style="--columns: {{ columns }}; --card-ratio: {{ ratio }};{% if section.settings.card_background != blank %} --card-bg: {{ section.settings.card_background }};{% endif %}{% if section.settings.card_image_background != blank %} --card-image-bg: {{ section.settings.card_image_background }};{% endif %}{% if section.settings.card_border_width > 0 %} --card-border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};{% endif %} --card-radius: {{ section.settings.card_radius | default: 4 }}px;"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="page-width" aria-labelledby="{{ heading_id }}">
      {%- render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        id: heading_id
      -%}
      <ul class="featured-products__grid" role="list">
        {%- for product in recommendations.products -%}
          <li class="featured-products__item">
            {%- assign card_id = section.id | append: '-' | append: product.id -%}
            {%- render 'product-card',
              card_id: card_id,
              product: product,
              show_rating: section.settings.show_rating,
              button_label: section.settings.card_button_label
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</product-recommendations>

{%- render 'section-spacing', section: section, target: '.section:has(.featured-products__grid)' -%}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations come from Shopify and improve with orders. Fine-tune them in the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Complete the glow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products",
      "default": 3
    },
    {
      "type": "select",
      "id": "width",
      "label": "Grid width",
      "options": [
        {
          "value": "contained",
          "label": "Contained, wide gaps"
        },
        {
          "value": "full",
          "label": "Full page width, tight gaps"
        }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "wide",
          "label": "Landscape (10:7)"
        },
        {
          "value": "standard",
          "label": "Slightly landscape (5:4)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame (edges may be cut)"
        },
        {
          "value": "contain",
          "label": "Show the whole image (no cut)"
        },
        {
          "value": "none",
          "label": "None (Image shape default)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "card_image_background",
      "label": "Card image background",
      "info": "Only the image area of the card. Leave empty to use the default."
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Card border thickness",
      "info": "0 = no border.",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E1DCD6"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Card button label"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Grey background",
      "default": false
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 56
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
