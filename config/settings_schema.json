[
  {
    "name": "theme_info",
    "theme_name": "Roxanne Rizzo",
    "theme_version": "0.1.0",
    "theme_author": "Arista Systems",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Headings",
        "default": "manrope_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body",
        "default": "manrope_n4"
      },
      {
        "type": "font_picker",
        "id": "type_logo_font",
        "label": "Text logo",
        "info": "Used only when no logo image is set in the header.",
        "default": "cormorant_n4"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "label": "Text",
        "default": "#1F2328"
      },
      {
        "type": "color",
        "id": "muted_color",
        "label": "Secondary text",
        "default": "#4A4D52"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent (bronze)",
        "info": "Eyebrows, highlighted heading lines and buttons.",
        "default": "#A6764F"
      },
      {
        "type": "color",
        "id": "accent_text_color",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "dark_color",
        "label": "Dark band",
        "info": "Announcement bar and rating strip.",
        "default": "#1F2329"
      },
      {
        "type": "color",
        "id": "dark_text_color",
        "label": "Text on dark band",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "section_alt_color",
        "label": "Light section background",
        "info": "Grey bands such as Reviews and the Instagram section.",
        "default": "#F4F4F4"
      },
      {
        "type": "color",
        "id": "card_color",
        "label": "Product card background",
        "default": "#F4F4F4"
      },
      {
        "type": "color",
        "id": "rating_color",
        "label": "Rating stars",
        "default": "#D49A2A"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          {
            "value": "75rem",
            "label": "Narrow"
          },
          {
            "value": "90rem",
            "label": "Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin (desktop)",
        "default": 50,
        "info": "Scales down to 16 px on phones."
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_overlay_home",
        "label": "Transparent header over the home page hero",
        "info": "Applies when the first home page section is the hero banner.",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Add to cart opens",
        "options": [
          {
            "value": "drawer",
            "label": "Mini cart (slide-out drawer)"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "collection",
        "id": "cart_empty_collection",
        "label": "Empty cart: link to collection",
        "info": "Where the Shop Now button in an empty cart goes. Defaults to all products."
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Order note on the cart page",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_dynamic_checkout",
        "label": "Show accelerated checkout buttons on the cart page",
        "info": "Shop Pay, Apple Pay and others you've enabled.",
        "default": true
      },
      {
        "type": "header",
        "content": "Free shipping progress bar"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping from (in your store currency)",
        "info": "E.g. 50. Leave empty to hide the bar. Shown in the mini cart and on the cart page, and only to shoppers paying in your store currency, so the amount is never wrong after currency conversion. Set up the matching free shipping rate in Settings → Shipping."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "header",
        "content": "Accounts"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/…"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/…"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@…"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest"
      }
    ]
  }
]
