{% doc %}
  One cart line: image, title, options, properties, discounts, quantity,
  remove link and line total. Shared by the cart page and the mini cart.

  @param {object} item - The line item
  @param {number} index - forloop.index, for unique ids
  @param {string} context - 'page' or 'drawer' (prefixes ids)

  @example
  {% render 'cart-line', item: item, index: forloop.index, context: 'drawer' %}
{% enddoc %}

{%- liquid
  assign compact = false
  if context == 'drawer'
    assign compact = true
  endif
  assign input_id = 'Quantity-' | append: context | append: '-' | append: index
  assign title = item.product.title | default: item.title
  assign max = null
  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
    assign max = item.variant.inventory_quantity
  endif
  assign qty_label = 'cart.quantity_for' | t: title: title
  if item.variant.quantity_rule.max
    assign max = item.variant.quantity_rule.max
  endif
-%}

<li class="cart-line" data-key="{{ item.key }}">
  <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 300
        | image_tag: widths: '150, 300', sizes: '(min-width: 750px) 150px, 96px', loading: 'lazy', alt: ''
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'cart-line__placeholder' }}
    {%- endif -%}
  </a>

  <div class="cart-line__info">
    {%- if item.vendor != blank and item.vendor != shop.name and compact == false -%}
      <p class="cart-line__vendor">{{ item.vendor | escape }}</p>
    {%- endif -%}
    <h3 class="cart-line__title">
      <a href="{{ item.url }}">{{ title | escape }}</a>
    </h3>

    {%- unless item.product.has_only_default_variant -%}
      <ul class="cart-line__meta" role="list">
        {%- for option in item.options_with_values -%}
          <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}

    {%- assign visible_properties = 0 -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        {%- assign visible_properties = visible_properties | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if visible_properties > 0 -%}
      <ul class="cart-line__meta" role="list">
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <li>
              {{ property.first | escape }}:
              {% if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>
              {%- else -%}
                {{ property.last | escape }}
              {%- endif %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if compact == false -%}
      <p class="cart-line__each">
        {%- if item.original_price > item.final_price -%}
          <s class="cart-line__was"><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ item.original_price | money }}</s>
        {%- endif -%}
        {%- assign each_price = item.final_price | money -%}
        {{ 'cart.each' | t: price: each_price }}
      </p>
    {%- endif -%}

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-line__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
        {%- for allocation in item.line_level_discount_allocations -%}
          <li>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="cart-line__actions">
      {%- render 'quantity-input',
        id: input_id,
        name: 'updates[]',
        value: item.quantity,
        min: 0,
        max: max,
        step: item.variant.quantity_rule.increment,
        key: item.key,
        title: title,
        label: qty_label,
        small: compact
      -%}
      <a class="cart-line__remove" href="{{ item.url_to_remove }}" data-cart-remove="{{ item.key }}">
        {{- 'cart.remove' | t -}}
        <span class="visually-hidden"> {{ title | escape }}</span>
      </a>
    </div>
  </div>

  <div class="cart-line__total">
    {%- if item.original_line_price > item.final_line_price -%}
      <s class="cart-line__was"><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ item.original_line_price | money }}</s>
    {%- endif -%}
    <span>{{ item.final_line_price | money }}</span>
  </div>
</li>
