{% comment %}
  "As seen in" press row: one logo image (or text) per block. Layout is
  either a row (evenly spread, wraps on small screens) or a slider built
  on <scroll-carousel> (assets/carousel.js) with optional autoplay, swipe,
  arrows and dots. Colors and sizes are printed as a style block scoped
  to this section's id.
{% endcomment %}

{{ 'section-logo-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign scope = '#shopify-section-' | append: section.id
  assign is_slider = false
  if st.layout == 'slider'
    assign is_slider = true
  endif

  comment
    Marquee: repeat the logos until a group holds 12+, so one group is wider
    than the screen; two identical groups then loop seamlessly.
  endcomment
  assign block_count = section.blocks.size | at_least: 1
  assign repeats = 12 | plus: block_count | minus: 1 | divided_by: block_count | at_least: 1
  assign marquee_duration = block_count | times: repeats | times: st.marquee_speed
  assign speed = 0
  if st.autoplay
    assign speed = st.autoplay_speed
  endif
  assign logo_h2x = st.logo_height | at_least: st.logo_height_mobile | times: 2
  assign track_label = st.heading
  if track_label == blank
    assign track_label = 'sections.logo_list.label' | t
  endif
-%}

{% style %}
  {{ scope }} .logo-list {
    {%- if st.background_color != blank %} background-color: {{ st.background_color }};{% endif %}
    --logo-height: {{ st.logo_height }}px;
    --logos-desktop: {{ st.logos_desktop }};
    --logos-tablet: {{ st.logos_tablet }};
    --logos-mobile: {{ st.logos_mobile }};
    --marquee-gap: {{ st.marquee_gap }}px;
  }
  {%- if st.heading_color != blank %}
  {{ scope }} .logo-list__heading { color: {{ st.heading_color }}; }
  {%- endif %}
  {%- if st.text_color != blank %}
  {{ scope }} .logo-list__text { color: {{ st.text_color }}; }
  {%- endif %}
  {%- if st.arrow_color != blank %}
  {{ scope }} .logo-list__arrow, {{ scope }} .carousel-dot { color: {{ st.arrow_color }}; }
  {%- endif %}

  @media (max-width: 749px) {
    {{ scope }} .logo-list {
      --logo-height: {{ st.logo_height_mobile }}px;
    }
  }
{% endstyle %}

<section class="section logo-list">
  <div class="page-width">
    {%- if st.heading != blank -%}
      <h2 class="logo-list__heading">{{ st.heading | escape }}</h2>
    {%- endif -%}

    {%- capture items -%}
      {%- for block in section.blocks -%}
        <li class="logo-list__item" {{ block.shopify_attributes }}>
          {%- capture logo -%}
            {%- if block.settings.image != blank -%}
              {%- assign logo_alt = block.settings.name | default: block.settings.image.alt -%}
              {%- if st.logo_size == 'actual' -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    loading: 'lazy',
                    alt: logo_alt,
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    class: 'logo-list__image logo-list__image--actual'
                }}
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: height: logo_h2x
                  | image_tag: loading: 'lazy', alt: logo_alt, class: 'logo-list__image'
                }}
              {%- endif -%}
            {%- else -%}
              <span class="logo-list__text">{{ block.settings.name | default: 'Logo' | escape }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="logo-list__link">{{ logo }}</a>
          {%- else -%}
            {{ logo }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_slider -%}
      <scroll-carousel
        class="logo-list__carousel{% if st.show_arrows %} logo-list__carousel--arrows-desktop{% endif %}{% if st.show_arrows_mobile %} logo-list__carousel--arrows-mobile{% endif %}{% if st.show_dots_desktop %} logo-list__carousel--dots-desktop{% endif %}{% if st.show_dots_tablet %} logo-list__carousel--dots-tablet{% endif %}{% if st.show_dots_mobile %} logo-list__carousel--dots-mobile{% endif %}"
        data-autoplay="{{ speed }}"{% if st.loop %} data-loop{% endif %}
      >
        {%- if st.show_arrows or st.show_arrows_mobile -%}
          <button type="button" class="logo-list__arrow logo-list__arrow--prev" data-carousel-prev hidden>
            {%- render 'icon', name: 'chevron-left' -%}
            <span class="visually-hidden">{{ 'sections.logo_list.previous' | t }}</span>
          </button>
        {%- endif -%}

        <ul
          class="logo-list__track{% if st.grayscale %} logo-list__list--grayscale{% endif %}{% unless st.swipe %} logo-list__track--no-swipe{% endunless %}"
          role="list"
          data-carousel-track
          tabindex="0"
          aria-label="{{ track_label | escape }}"
        >
          {{- items -}}
        </ul>

        {%- if st.show_arrows or st.show_arrows_mobile -%}
          <button type="button" class="logo-list__arrow logo-list__arrow--next" data-carousel-next hidden>
            {%- render 'icon', name: 'chevron-right' -%}
            <span class="visually-hidden">{{ 'sections.logo_list.next' | t }}</span>
          </button>
        {%- endif -%}

        {%- if st.show_dots_desktop or st.show_dots_tablet or st.show_dots_mobile -%}
          <div class="logo-list__dots" data-carousel-dots data-label="{{ 'sections.reviews.go_to' | t: number: '[n]' | escape }}" hidden></div>
        {%- endif -%}
      </scroll-carousel>
      <script src="{{ 'carousel.js' | asset_url }}" defer></script>
    {%- elsif st.layout == 'marquee' -%}
      <div
        class="logo-list__marquee{% if st.marquee_pause %} logo-list__marquee--pause{% endif %}{% if st.marquee_direction == 'right' %} logo-list__marquee--reverse{% endif %}"
        style="--marquee-duration: {{ marquee_duration }}s;"
      >
        <div class="logo-list__marquee-track">
          {%- for copy in (1..2) -%}
            <ul
              class="logo-list__marquee-group{% if st.grayscale %} logo-list__list--grayscale{% endif %}"
              role="list"
              {% if copy == 2 %}
                aria-hidden="true" inert
              {% else %}
                aria-label="{{ track_label | escape }}"
              {% endif %}
            >
              {%- for i in (1..repeats) -%}
                {{- items -}}
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <ul class="logo-list__list{% if st.grayscale %} logo-list__list--grayscale{% endif %}" role="list">
        {{- items -}}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- render 'section-spacing', section: section -%}

{% schema %}
{
  "name": "Logo list",
  "tag": "div",
  "class": "logo-list-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional, e.g. As seen in."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Row (all logos, wraps on phones)"
        },
        {
          "value": "slider",
          "label": "Slider (one step at a time)"
        },
        {
          "value": "marquee",
          "label": "Infinite continuous scroll"
        }
      ],
      "default": "row"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "paragraph",
      "content": "Add a logo or icon with \"Add Logo\", then pick the image in the block. Without an image the name shows as text."
    },
    {
      "type": "select",
      "id": "logo_size",
      "label": "Logo size",
      "options": [
        {
          "value": "height",
          "label": "Same height for all logos"
        },
        {
          "value": "actual",
          "label": "Actual image size"
        }
      ],
      "default": "height",
      "info": "Actual image size shows each image at its uploaded pixel size (never wider than its space)."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Logo height on desktop",
      "default": 56,
      "info": "Used with \"Same height for all logos\"."
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Logo height on mobile",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in black",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text logo color",
      "info": "For logos shown as text (no image)."
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow and dot color"
    },
    {
      "type": "paragraph",
      "content": "Leave a color empty to use the theme default."
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "paragraph",
      "content": "These apply when Layout is Slider."
    },
    {
      "type": "select",
      "id": "logos_desktop",
      "label": "Logos per view on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "7",
          "label": "7"
        },
        {
          "value": "8",
          "label": "8"
        }
      ],
      "default": "6"
    },
    {
      "type": "select",
      "id": "logos_tablet",
      "label": "Logos per view on tablet",
      "info": "Screens 750–989px wide.",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "logos_mobile",
      "label": "Logos per view on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "2.5",
          "label": "2 + peek of the next logo"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2.5"
    },
    {
      "type": "checkbox",
      "id": "swipe",
      "label": "Allow swipe / scroll",
      "info": "Off: logos move only with arrows, dots or auto-slide, so keep at least one of them on.",
      "default": true
