{% doc %}
  Header search: a <dialog> with the search field and live suggestions
  (predictive-search section). The header icon still links to /search, so
  search works without JavaScript; theme.js opens this dialog instead.

  @param {string} [logo_markup] - The header logo (image or text wordmark), shown left of the field
  @param {number} [logo_width] - Logo image width in px (header setting)
  @param {object} [popular_menu] - "Popular tags" links shown while the field is empty
  @param {collection} [popular_collection] - "Popular products" (falls back to all products)
  @param {number} [popular_limit] - How many popular products to show (0 hides them)
  @param {string} [image_ratio] - Popular products image shape: wide | standard | square | portrait (default square)
  @param {string} [image_fit] - contain (whole image) | cover (fill, may cut) (default contain)
  @param {number} [columns] - Popular products visible at once on desktop (default 5)
  @param {string} [card_image_bg] - Color behind the card image (blank = default)
  @param {string} [card_bg] - Card background color (blank = theme card color)
  @param {number} [card_border_width] - Card border in px (0 = none)
  @param {string} [card_border_color] - Card border color
  @param {number} [card_radius] - Card corner radius in px (default 4)
  @param {string} [cancel_label] - Text of the close button (default "Cancel")
  @param {string} [tags_heading] - Heading over the tags (default "Popular Tags")
  @param {string} [products_heading] - Heading over the products (default "Popular Products")

  @example
  {% render 'search-modal', logo_markup: logo_markup %}
{% enddoc %}

<search-modal class="search-modal"{% if logo_width %} style="--logo-width: {{ logo_width }}px;"{% endif %}>
  <link rel="stylesheet" href="{{ 'component-search-modal.css' | asset_url }}" media="print" onload="this.media='all'">
  <dialog class="search-modal__dialog" aria-label="{{ 'search.label' | t }}" scroll-lock data-search-dialog>
    <div class="search-modal__panel">
      <predictive-search class="search-modal__inner" data-url="{{ routes.predictive_search_url }}">
        <div class="search-modal__bar">
          {%- if logo_markup != blank -%}
            <a class="header__logo search-modal__logo" href="{{ routes.root_url }}">
              {{- logo_markup -}}
            </a>
          {%- endif -%}

          <form class="search-modal__form" action="{{ routes.search_url }}" method="get" role="search">
            {%- render 'icon', name: 'search', class: 'search-modal__icon' -%}
            <label class="visually-hidden" for="SearchModalInput">{{ 'search.label' | t }}</label>
            <input
              class="search-modal__input"
              id="SearchModalInput"
              type="search"
              name="q"
              placeholder="{{ 'search.title' | t }}"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              role="combobox"
              aria-expanded="false"
              aria-controls="PredictiveResultsWrap"
              aria-autocomplete="list"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="button" class="search-modal__clear" data-search-clear hidden>
              {%- render 'icon', name: 'close' -%}
              <span class="visually-hidden">{{ 'search.clear' | t }}</span>
            </button>
          </form>

          <button type="button" class="search-modal__cancel" data-search-close>
            {{- cancel_label | default: 'Cancel' | escape -}}
          </button>
        </div>
        <div id="PredictiveResultsWrap" class="search-modal__results" data-predictive-results aria-live="polite"></div>
        <p class="visually-hidden" role="status" data-predictive-status></p>

        {%- liquid
          assign popular_limit = popular_limit | default: 0
          if popular_collection != blank
            assign popular_products = popular_collection.products
          else
            assign popular_products = collections.all.products
          endif
          assign show_tags = false
          if popular_menu != blank and popular_menu.links.size > 0
            assign show_tags = true
          endif
          assign show_products = false
          if popular_limit > 0 and popular_products.size > 0
            assign show_products = true
          endif
        -%}

        {%- if show_tags or show_products -%}
          <div class="search-popular{% unless show_tags %} search-popular--no-tags{% endunless %}" data-search-popular>
            {%- if show_tags -%}
              <nav class="search-popular__tags" aria-labelledby="SearchPopularTags">
                <p class="search-popular__title" id="SearchPopularTags">{{ tags_heading | default: 'Popular Tags' | escape }}</p>
                <ul class="search-popular__tag-list" role="list">
                  {%- for link in popular_menu.links -%}
                    <li><a class="search-popular__tag" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}

            {%- if show_products -%}
              <link rel="stylesheet" href="{{ 'component-product-card.css' | asset_url }}" media="print" onload="this.media='all'">
              <script src="{{ 'carousel.js' | asset_url }}" defer></script>
              {%- liquid
                case image_ratio
                  when 'wide'
                    assign card_ratio = '10 / 7'
                  when 'standard'
                    assign card_ratio = '5 / 4'
                  when 'portrait'
                    assign card_ratio = '4 / 5'
                  else
                    assign card_ratio = '1 / 1'
                endcase
                assign card_fit = image_fit | default: 'contain'
                assign search_columns = columns | default: 5
                assign card_image_bg = card_image_bg | append: ''
                assign card_bg = card_bg | append: ''
              -%}
              <scroll-carousel
                class="search-popular__products card-fit--{{ card_fit }}"
                style="--card-ratio: {{ card_ratio }}; --search-columns: {{ search_columns }};{% if card_image_bg != blank and card_image_bg != 'rgba(0,0,0,0)' %} --card-image-bg: {{ card_image_bg }};{% endif %}{% if card_bg != blank and card_bg != 'rgba(0,0,0,0)' %} --card-bg: {{ card_bg }};{% endif %}{% if card_border_width > 0 %} --card-border: {{ card_border_width }}px solid {{ card_border_color | default: '#E1DCD6' }};{% endif %} --card-radius: {{ card_radius | default: 4 }}px;"
              >
                <div class="search-popular__head">
                  <p class="search-popular__title" id="SearchPopularProducts">{{ products_heading | default: 'Popular Products' | escape }}</p>
                  <div class="search-popular__arrows">
                    <button type="button" class="search-popular__arrow" data-carousel-prev hidden>
                      {%- render 'icon', name: 'chevron-left' -%}
                      <span class="visually-hidden">Previous products</span>
                    </button>
                    <button type="button" class="search-popular__arrow" data-carousel-next hidden>
                      {%- render 'icon', name: 'chevron-right' -%}
                      <span class="visually-hidden">Next products</span>
                    </button>
                  </div>
                </div>
                <ul class="search-popular__track" role="list" data-carousel-track tabindex="0" aria-labelledby="SearchPopularProducts">
                  {%- for product in popular_products limit: popular_limit -%}
                    <li class="search-popular__item">
                      {%- assign card_id = 'search-popular-' | append: forloop.index -%}
                      {%- render 'product-card',
                        card_id: card_id,
                        product: product,
                        show_rating: true,
                        sizes: '(min-width: 990px) 16vw, (min-width: 750px) 30vw, 60vw'
                      -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </scroll-carousel>
            {%- endif -%}
          </div>
        {%- endif -%}
      </predictive-search>
    </div>
  </dialog>
</search-modal>
