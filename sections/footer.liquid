{% comment %}
  Basic footer: one menu, copyright and payment icons. Placeholder until
  the footer design is supplied.
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer">
  <div class="footer__inner page-width">
    {%- if section.settings.menu != blank -%}
      <nav aria-label="{{ 'sections.footer.navigation' | t }}">
        <ul class="footer__links">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <p class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}
    </p>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "footer-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
