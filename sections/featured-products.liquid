{% comment %}
  Product grid with a centred heading. Used twice on the home page:
  "Explore favorites" (3 boxed cards with badge + rating) and "The travel
  collection" (4 full-width cards with a Shop Now button). Products come
  from blocks (each with its own badge); with no blocks, from a collection.
  Swipeable row on phones (CSS scroll snap, no JavaScript).
{% endcomment %}

{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_id = 'FeaturedHeading-' | append: section.id
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '10 / 7'
    else
      assign ratio = '5 / 4'
  endcase
  assign columns = section.settings.columns
  if section.settings.width == 'full'
    assign sizes = '(min-width: 990px) calc(100vw / ' | append: columns | append: '), (min-width: 750px) 50vw, 80vw'
  else
    assign sizes = '(min-width: 990px) calc(1180px / ' | append: columns | append: '), (min-width: 750px) 50vw, 80vw'
  endif
-%}

<section
  class="section featured-products featured-products--{{ section.settings.width }} card-fit--{{ section.settings.image_fit | default: 'cover' }}"
  style="--columns: {{ columns }}; --card-ratio: {{ ratio }};{% if section.settings.background_color != blank %} background-color: {{ section.settings.background_color }};{% endif %}{% if section.settings.card_background != blank %} --card-bg: {{ section.settings.card_background }};{% endif %}{% if section.settings.card_image_background != blank %} --card-image-bg: {{ section.settings.card_image_background }};{% endif %}{% if section.settings.card_border_width > 0 %} --card-border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};{% endif %} --card-radius: {{ section.settings.card_radius | default: 4 }}px;"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      id: heading_id
    -%}

    <ul class="featured-products__grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign badge_style = ''
            if block.settings.badge_background != blank
              assign badge_style = badge_style | append: '--badge-bg: ' | append: block.settings.badge_background | append: ';'
            endif
            if block.settings.badge_border != blank
              assign badge_style = badge_style | append: '--badge-border: ' | append: block.settings.badge_border | append: ';'
            endif
            if block.settings.badge_text != blank
              assign badge_style = badge_style | append: '--badge-text: ' | append: block.settings.badge_text | append: ';'
            endif
          -%}
          <li class="featured-products__item" {% if badge_style != blank %}style="{{ badge_style }}"{% endif %} {{ block.shopify_attributes }}>
            {%- render 'product-card',
              card_id: block.id,
              product: block.settings.product,
              badge: block.settings.badge,
              show_rating: section.settings.show_rating,
              button_label: section.settings.card_button_label,
              sizes: sizes
            -%}
          </li>
        {%- endfor -%}
      {%- elsif section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_limit -%}
          <li class="featured-products__item">
            {%- assign card_id = section.id | append: '-' | append: product.id -%}
            {%- render 'product-card',
              card_id: card_id,
              product: product,
              show_rating: section.settings.show_rating,
              button_label: section.settings.card_button_label,
              sizes: sizes
            -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..columns) -%}
          <li class="featured-products__item">
            {%- assign card_id = section.id | append: '-placeholder-' | append: i -%}
            {%- render 'product-card', card_id: card_id, button_label: section.settings.card_button_label -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="featured-products__footer">
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- render 'section-spacing', section: section -%}

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "class": "featured-products-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore favorites"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bestsellers, new arrivals, and value sets loved by makeup artists worldwide.</p>"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "paragraph",
      "content": "Add Product blocks to pick products and give each a badge. With no blocks, products come from the collection below."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products from collection",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "width",
      "label": "Grid width",
      "options": [
        {
          "value": "contained",
          "label": "Contained, wide gaps"
        },
        {
          "value": "full",
          "label": "Full page width, tight gaps"
        }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "wide",
          "label": "Landscape (10:7)"
        },
        {
          "value": "standard",
          "label": "Slightly landscape (5:4)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame (edges may be cut)"
        },
        {
          "value": "contain",
          "label": "Show the whole image (no cut)"
        },
        {
          "value": "none",
          "label": "None (Image shape default)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "info": "Leave empty to use the theme background."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Leave empty to use the theme's product card color."
    },
    {
      "type": "color",
      "id": "card_image_background",
      "label": "Card image background",
      "info": "Only the image area of the card. Leave empty to use the default."
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Card border thickness",
      "info": "0 = no border.",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#E1DCD6"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "From your reviews app (product metafields reviews.rating and reviews.rating_count).",
      "default": true
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Card button label",
      "info": "E.g. Shop Now. Leave empty for no button on cards."
    },
    {
      "type": "header",
      "content": "Button below the grid"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "info": "Leave empty to hide."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "E.g. Best seller, New arrival, Value set. Leave empty for none."
        },
        {
          "type": "color",
          "id": "badge_background",
          "label": "Badge background",
          "info": "Leave colors empty to use the default badge style."
        },
        {
          "type": "color",
          "id": "badge_border",
          "label": "Badge border"
        },
        {
          "type": "color",
          "id": "badge_text",
          "label": "Badge text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "badge": "Value set"
          }
        },
        {
          "type": "product",
          "settings": {
            "badge": "New arrival"
          }
        },
        {
          "type": "product",
          "settings": {
            "badge": "Best seller"
          }
        }
      ]
    },
    {
      "name": "Product row with buttons",
      "settings": {
        "eyebrow": "The accessories",
        "heading": "The travel collection",
        "text": "<p>Vibrant beauty bags featuring Roxanne's original artwork, available in four sizes for your essentials.</p>",
        "columns": 4,
        "width": "full",
        "image_ratio": "standard",
        "show_rating": false,
        "card_button_label": "Shop Now",
        "card_background": "#EAEAEB"
      }
    }
  ]
}
{% endschema %}
