{% doc %}
  Journal card: image on the theme's grey card, date eyebrow, title,
  excerpt and a "Read more" link. The whole card is clickable.

  @param {article} article - The article
  @param {string} [sizes] - Image sizes attribute
  @param {boolean} [show_excerpt] - Show the excerpt, default true

  @example
  {% render 'article-card', article: article %}
{% enddoc %}

{%- liquid
  assign heading_id = 'ArticleCard-' | append: article.id
  assign sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  assign excerpt = article.excerpt | default: article.content | strip_html | truncatewords: 26
-%}

<article class="article-card" aria-labelledby="{{ heading_id }}">
  <div class="article-card__media">
    {%- if article.image -%}
      {{
        article.image
        | image_url: width: 1200
        | image_tag: widths: '400, 600, 800, 1200', sizes: sizes, loading: 'lazy', alt: article.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'article-card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="article-card__body">
    <p class="eyebrow article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h3 class="article-card__title" id="{{ heading_id }}">
      <a class="article-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
    </h3>
    {%- if show_excerpt != false and excerpt != blank -%}
      <p class="article-card__excerpt">{{ excerpt }}</p>
    {%- endif -%}
    <span class="article-card__more" aria-hidden="true">
      {{- 'blog.read_more' | t -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </span>
  </div>
</article>
