{% comment %}
  "You may also like": Shopify's related-product recommendations, loaded
  after the page when the section scrolls near (product.js), and shown in
  the same product row as the home page's "Explore favorites".
{% endcomment %}

{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer></script>

{%- liquid
  assign heading_id = 'RecommendationsHeading-' | append: section.id
  assign columns = section.settings.columns
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '10 / 7'
    else
      assign ratio = '5 / 4'
  endcase
-%}

<product-recommendations
  class="section featured-products featured-products--contained{% if section.settings.alt_background %} section--alt{% endif %}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ columns }}&intent=related"
  style="--columns: {{ columns }}; --card-ratio: {{ ratio }};{% if section.settings.card_background != blank %} --card-bg: {{ section.settings.card_background }};{% endif %}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="page-width" aria-labelledby="{{ heading_id }}">
      {%- render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        id: heading_id
      -%}
      <ul class="featured-products__grid" role="list">
        {%- for product in recommendations.products -%}
          <li class="featured-products__item">
            {%- assign card_id = section.id | append: '-' | append: product.id -%}
            {%- render 'product-card',
              card_id: card_id,
              product: product,
              show_rating: section.settings.show_rating,
              button_label: section.settings.card_button_label
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations come from Shopify and improve with orders. Fine-tune them in the Search & Discovery app."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the glow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "wide", "label": "Landscape (10:7)" },
        { "value": "standard", "label": "Slightly landscape (5:4)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "wide"
    },
    { "type": "color", "id": "card_background", "label": "Card background" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "card_button_label", "label": "Card button label" },
    { "type": "checkbox", "id": "alt_background", "label": "Grey background", "default": false }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
