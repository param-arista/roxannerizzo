<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {% render 'css-variables' %}

    {% unless settings.type_heading_font.system? and settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}
    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% if settings.type_body_font != settings.type_heading_font %}
      {% unless settings.type_body_font.system? %}
        {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.add('js');
      window.theme = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          cartError: {{ 'cart.error' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          added: {{ 'cart.added' | t | json }},
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          resultsUpdated: {{ 'collections.results_updated' | t | json }},
          loading: {{ 'general.loading' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  {% liquid
    assign body_class = 'template-' | append: template.name
    if template.name == 'index' and settings.header_overlay_home
      assign body_class = body_class | append: ' has-overlay-header'
    endif
  %}
  <body class="{{ body_class }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <p class="visually-hidden" role="status" aria-live="polite" id="ThemeAnnouncer"></p>
  </body>
</html>
