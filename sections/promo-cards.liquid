{% comment %}
  "Our bestsellers / Shop the glow": large lifestyle images, each with a
  title on the left and a small button on the right underneath.
{% endcomment %}

{{ 'section-promo-cards.css' | asset_url | stylesheet_tag }}

{%- assign heading_id = 'PromoHeading-' | append: section.id -%}

<section
  class="section promo-cards"
  style="--columns: {{ section.settings.columns }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, id: heading_id -%}

    <ul class="promo-cards__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="promo-card" {{ block.shopify_attributes }}>
          <div class="promo-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '480, 720, 960, 1200, 1400',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="promo-card__footer">
            {%- if block.settings.title != blank -%}
              <h3 class="promo-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="button promo-card__button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                {{- block.settings.button_label | escape -}}
                {%- if block.settings.title != blank -%}
                  <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Promo cards",
  "tag": "div",
  "class": "promo-cards-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the glow"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Cards per row on desktop",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product name"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
