      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Slide every",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows on desktop and tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show arrows on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots_desktop",
      "label": "Show dots on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots_tablet",
      "label": "Show dots on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots_mobile",
      "label": "Show dots on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Infinite continuous scroll"
    },
    {
      "type": "paragraph",
      "content": "These apply when Layout is Infinite continuous scroll."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "label": "Speed (seconds per logo)",
      "info": "Lower is faster.",
      "default": 3
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Gap between logos",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "marquee_pause",
      "label": "Pause on mouse hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo or icon",
          "info": "Transparent PNG or SVG works best."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Shown as text when no image is set, and read out by screen readers, e.g. Vogue."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional, e.g. the article."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
