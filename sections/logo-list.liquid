{% comment %}
  "As seen in" press row: one logo image per block, evenly spread.
  Wraps to rows on small screens.
{% endcomment %}

{{ 'section-logo-list.css' | asset_url | stylesheet_tag }}

<section class="section logo-list" style="--section-padding: clamp(2.5rem, 4.5vw, 3.75rem); --logo-height: {{ section.settings.logo_height }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="logo-list__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="logo-list__list{% if section.settings.grayscale %} logo-list__list--grayscale{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="logo-list__item" {{ block.shopify_attributes }}>
          {%- capture logo -%}
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign logo_alt = block.settings.name | default: block.settings.image.alt
                assign logo_h2x = section.settings.logo_height | times: 2
              -%}
              {{
                block.settings.image
                | image_url: height: logo_h2x
                | image_tag: loading: 'lazy', alt: logo_alt, class: 'logo-list__image'
              }}
            {%- else -%}
              <span class="logo-list__text">{{ block.settings.name | default: 'Logo' | escape }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="logo-list__link">{{ logo }}</a>
          {%- else -%}
            {{ logo }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logo list",
  "tag": "div",
  "class": "logo-list-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional, e.g. As seen in."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in black",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Transparent PNG or SVG works best."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Read out by screen readers, e.g. Vogue."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional, e.g. the article."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
