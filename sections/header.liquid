{% comment %}
  Site header: logo (image, or star + text wordmark), centred main menu,
  and search / account / wishlist / cart icons. Below 990px the menu moves
  into a details/summary drawer (no JavaScript).
{% endcomment %}

{%- liquid
  assign menu = section.settings.menu
  assign logo = section.settings.logo
  assign logo_width_2x = section.settings.logo_width | times: 2
  assign logo_widths = section.settings.logo_width | append: ',' | append: logo_width_2x
-%}

<sticky-header data-sticky="{{ section.settings.sticky_header }}">
<header class="header" style="--logo-width: {{ section.settings.logo_width }}px;">
  <div class="header__inner">
    {%- if menu != blank -%}
      <details class="header__drawer" scroll-lock>
        <summary class="header__icon" aria-label="{{ 'sections.header.menu' | t }}">
          {%- render 'icon', name: 'menu' -%}
          {%- render 'icon', name: 'close' -%}
        </summary>
        <nav class="header__drawer-panel" style="--drawer-top: calc(var(--header-height) + 2.25rem);" aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="header__drawer-menu">
            {%- for link in menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
            {%- if shop.customer_accounts_enabled -%}
              <li>
                <a href="{{ routes.account_url }}">{{ 'sections.header.account' | t }}</a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      </details>
    {%- endif -%}

    {%- capture logo_markup -%}
        {%- if logo != blank -%}
          {{
            logo
            | image_url: width: logo_width_2x
            | image_tag:
              alt: shop.name,
              widths: logo_widths,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          {%- if section.settings.show_star -%}
            <svg class="header__logo-star" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="m12 1.5 2.6 7.6h8l-6.5 4.8 2.5 7.6L12 16.8l-6.6 4.7 2.5-7.6-6.5-4.8h8L12 1.5Z"/></svg>
          {%- endif -%}
          <span class="header__logo-name">{{ section.settings.logo_text | default: shop.name | escape }}</span>
          {%- if section.settings.logo_tagline != blank -%}
            <span class="header__logo-tagline">{{ section.settings.logo_tagline | escape }}</span>
          {%- endif -%}
        {%- endif -%}
    {%- endcapture -%}

    <a class="header__logo" href="{{ routes.root_url }}">
      {{- logo_markup -}}
    </a>

    {%- if menu != blank -%}
      <nav class="header__nav" aria-label="{{ 'sections.header.main_navigation' | t }}">
        <ul class="header__menu">
          {%- for link in menu.links -%}
            <li>
              <a
                class="header__menu-link"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__icons">
      <a class="header__icon" href="{{ routes.search_url }}" data-search-open aria-haspopup="dialog">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">{{ 'sections.header.search' | t }}</span>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a class="header__icon header__icon--desktop" href="{{ routes.account_url }}">
          {%- render 'icon', name: 'account' -%}
          <span class="visually-hidden">{{ 'sections.header.account' | t }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.wishlist_url != blank -%}
        <a class="header__icon header__icon--desktop" href="{{ section.settings.wishlist_url }}">
          {%- render 'icon', name: 'heart' -%}
          <span class="visually-hidden">{{ 'sections.header.wishlist' | t }}</span>
        </a>
      {%- endif -%}

      <a
        class="header__icon"
        href="{{ routes.cart_url }}"
        id="HeaderCartIcon"
        {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
          data-cart-open aria-haspopup="dialog"
        {% endif %}
      >
        {%- render 'icon', name: 'bag' -%}
        <span class="visually-hidden" data-cart-label>{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        <span class="header__cart-count" aria-hidden="true" data-cart-bubble {% if cart.item_count == 0 %}hidden{% endif %}>
          {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
        </span>
      </a>
    </div>
  </div>
</header>
</sticky-header>

{%- render 'search-modal',
  logo_markup: logo_markup,
  logo_width: section.settings.logo_width,
  popular_menu: section.settings.search_menu,
  popular_collection: section.settings.search_collection,
  popular_limit: section.settings.search_products_limit,
  image_ratio: section.settings.search_image_ratio,
  image_fit: section.settings.search_image_fit,
  columns: section.settings.search_columns,
  card_image_bg: section.settings.search_card_image_background,
  card_bg: section.settings.search_card_background,
  card_border_width: section.settings.search_card_border_width,
  card_border_color: section.settings.search_card_border_color,
  card_radius: section.settings.search_card_radius,
  cancel_label: section.settings.search_cancel_label,
  tags_heading: section.settings.search_tags_heading,
  products_heading: section.settings.search_products_heading
-%}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "header-section",
  "settings": [
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "None (scrolls away with the page)" },
        { "value": "always", "label": "Always visible" },
        { "value": "scroll-up", "label": "Hide on scroll down, show on scroll up" }
      ],
      "default": "always",
      "info": "On the home page the header stays transparent over the hero and turns solid once you scroll (see Theme settings > Header)."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use the star + text wordmark below."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Logo image width",
      "default": 220
    },
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show star before text logo",
      "default": true
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text logo",
      "info": "Defaults to the store name."
    },
    {
      "type": "text",
      "id": "logo_tagline",
      "label": "Text logo tagline",
      "default": "New York"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist link",
      "info": "The heart icon shows only when this is set (e.g. your wishlist app's page)."
    },
    {
      "type": "header",
      "content": "Search popup"
    },
    {
      "type": "text",
      "id": "search_cancel_label",
      "label": "Close button label",
      "default": "Cancel"
    },
    {
      "type": "text",
      "id": "search_tags_heading",
      "label": "Popular tags heading",
      "default": "Popular Tags"
    },
    {
      "type": "text",
      "id": "search_products_heading",
      "label": "Popular products heading",
      "default": "Popular Products"
    },
    {
      "type": "link_list",
      "id": "search_menu",
      "label": "Popular tags menu",
      "info": "Links listed on the left when the search field is empty. Empty = hidden."
    },
    {
      "type": "collection",
      "id": "search_collection",
      "label": "Popular products collection",
      "info": "Products shown in a slider when the search field is empty. Empty = all products."
    },
    {
      "type": "range",
      "id": "search_products_limit",
      "min": 0,
      "max": 12,
      "step": 1,
      "label": "Popular products to show",
      "info": "0 hides the products.",
      "default": 8
    },
    {
      "type": "select",
      "id": "search_image_ratio",
      "label": "Popular products image shape",
      "options": [
        { "value": "wide", "label": "Landscape (10:7)" },
        { "value": "standard", "label": "Slightly landscape (5:4)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "search_image_fit",
      "label": "Popular products image fit",
      "options": [
        { "value": "contain", "label": "Show the whole image (no cut)" },
        { "value": "cover", "label": "Fill the frame (edges may be cut)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "search_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Popular products visible on desktop",
      "info": "Cards in view at once; the rest scroll with the arrows. Laptop shows up to 4, tablet 2.5, phone 1.6.",
      "default": 5
    },
    {
      "type": "color",
      "id": "search_card_image_background",
      "label": "Popular products card image background",
      "info": "Only the image area of the card. Leave empty to use the default."
    },
    {
      "type": "color",
      "id": "search_card_background",
      "label": "Popular products card background",
      "info": "The whole card (under the title and price). Leave empty to use the theme's product card color."
    },
    {
      "type": "range",
      "id": "search_card_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Popular products card border thickness",
      "info": "0 = no border.",
      "default": 0
    },
    {
      "type": "color",
      "id": "search_card_border_color",
      "label": "Popular products card border color",
      "default": "#E1DCD6"
    },
    {
      "type": "range",
      "id": "search_card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Popular products card corner radius",
      "default": 4
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
