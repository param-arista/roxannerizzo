{% comment %}
  Password page ("coming soon"): image beside the brand wordmark, a
  heading, the store's password message, an email signup, social icons
  and the password form tucked behind "Enter using password".
{% endcomment %}

{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign signup_id = 'PasswordSignup-' | append: section.id
  assign password_id = 'PasswordForm-' | append: section.id
-%}

<section class="password" aria-labelledby="PasswordHeading-{{ section.id }}">
  <div class="password__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          widths: '600, 900, 1200, 1500, 1800',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'password__placeholder' }}
    {%- endif -%}
  </div>

  <div class="password__content">
    <p class="password__logo">
      <svg class="password__star" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="m12 1.5 2.6 7.6h8l-6.5 4.8 2.5 7.6L12 16.8l-6.6 4.7 2.5-7.6-6.5-4.8h8L12 1.5Z"/></svg>
      <span class="password__name">{{ section.settings.logo_text | default: shop.name | escape }}</span>
      {%- if section.settings.logo_tagline != blank -%}
        <span class="password__tagline">{{ section.settings.logo_tagline | escape }}</span>
      {%- endif -%}
    </p>

    <div class="password__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="password__heading" id="PasswordHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="password__message">{{ shop.password_message | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: signup_id, class: 'password__signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, password-page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'password.signup_success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="password__field">
            <label class="visually-hidden" for="{{ signup_id }}-email">{{ 'password.signup_label' | t }}</label>
            <input
              class="field__input"
              id="{{ signup_id }}-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              placeholder="{{ 'password.signup_label' | t }}"
              required
            >
            <button type="submit" class="button">{{ 'password.signup_submit' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- render 'social-icons' -%}

    {%- capture password_form -%}
      {%- form 'storefront_password', id: password_id, class: 'password__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'password.wrong_password' | t }}</p>
        {%- endif -%}
        <div class="password__field">
          <label class="visually-hidden" for="{{ password_id }}-input">{{ 'password.password' | t }}</label>
          <input
            class="field__input"
            id="{{ password_id }}-input"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'password.password' | t }}"
            required
            {% if form.errors %}
              aria-invalid="true" autofocus
            {% endif %}
          >
          <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    {%- endcapture -%}

    <details class="password__enter" {% if password_form contains 'form-message--error' %}open{% endif %}>
      <summary>{{ 'password.enter_using_password' | t }}</summary>
      {{ password_form }}
      <p class="password__admin">
        {{ 'password.store_owner' | t }}
        <a href="/admin">{{ 'password.admin_link' | t }}</a>
      </p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "main-password-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "logo_text", "label": "Text logo", "default": "Roxanne Rizzo" },
    { "type": "text", "id": "logo_tagline", "label": "Text logo tagline", "default": "New York" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something glowing is on its way" },
    {
      "type": "paragraph",
      "content": "The message under the heading is the one set in Online Store → Preferences → Password protection."
    },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true }
  ],
  "enabled_on": { "templates": ["password"] }
}
{% endschema %}
