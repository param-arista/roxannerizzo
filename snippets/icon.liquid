{% doc %}
  Renders an inline SVG icon. Decorative by default (aria-hidden); give the
  surrounding link or button an accessible name.

  @param {string} name - search | account | heart | bag | star | menu | close
  @param {string} [class] - Extra classes

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}

{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon icon-search {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon-account {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.2-3.6 4.1-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
  {%- when 'heart' -%}
    <svg class="icon icon-heart {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-8.9-9.4C2.2 7.9 4.3 4.5 7.7 4.5c1.9 0 3.3 1 4.3 2.6 1-1.6 2.4-2.6 4.3-2.6 3.4 0 5.5 3.4 4.6 6.6-1.4 4.8-8.9 9.4-8.9 9.4Z"/></svg>
  {%- when 'bag' -%}
    <svg class="icon icon-bag {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M5 8h14l-1 12.5H6L5 8Z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10" stroke-linecap="round"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon-star {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.5 2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6L12 2.5Z"/></svg>
  {%- when 'menu' -%}
    <svg class="icon icon-menu {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3.5 7h17M3.5 12h17M3.5 17h17"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon-close {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="m5.5 5.5 13 13M18.5 5.5l-13 13"/></svg>
{%- endcase -%}
