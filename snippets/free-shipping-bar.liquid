{% doc %}
  "You're $X away from free shipping" with a progress bar, from Theme
  settings → Cart → Free shipping from. Hidden when no threshold is set or
  the shopper pays in another currency (Liquid has no conversion rate, so
  a converted amount could be wrong). Re-rendered with the cart sections.

  @example
  {% render 'free-shipping-bar' %}
{% enddoc %}

{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100 | round
  assign show_bar = false
  if threshold > 0 and cart.item_count > 0 and cart.currency.iso_code == shop.currency
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 | at_least: 0
  -%}
  <div class="free-shipping{% if remaining <= 0 %} free-shipping--reached{% endif %}">
    <p class="free-shipping__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div
      class="free-shipping__track"
      role="progressbar"
      aria-label="{{ 'cart.free_shipping_label' | t }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ percent }}"
    >
      <span class="free-shipping__fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
