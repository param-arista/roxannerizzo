{% comment %}
  Search results page: large search field under the home page style
  heading, product results in the shared product-card grid (with filters
  and sort), pages and articles listed below them. With no search, or no
  results, a "Popular right now" product row from a chosen collection.
{% endcomment %}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-main-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer></script>

{%- liquid
  assign heading_id = 'SearchHeading-' | append: section.id
  assign columns = section.settings.columns
  assign sizes = '(min-width: 990px) calc((100vw - 22rem) / ' | append: columns | append: '), (min-width: 750px) 33vw, 50vw'
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '10 / 7'
    else
      assign ratio = '5 / 4'
  endcase
  assign grid_style = '--columns: ' | append: columns | append: '; --card-ratio: ' | append: ratio | append: ';'
  if section.settings.card_background != blank
    assign grid_style = grid_style | append: ' --card-bg: ' | append: section.settings.card_background | append: ';'
  endif
-%}

<section class="main-search main-collection" aria-labelledby="{{ heading_id }}">
  <div class="page-width main-collection__inner">
    {%- render 'page-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading, id: heading_id -%}

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.label' | t }}</label>
      <input
        class="search-form__input"
        id="SearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="search-form__submit" type="submit">
        {%- render 'icon', name: 'search' -%}
        <span class="visually-hidden">{{ 'search.submit' | t }}</span>
      </button>
    </form>

    {%- if search.performed -%}
      <p class="search-summary" role="status">
        {%- if search.results_count == 0 -%}
          {{ 'search.no_results' | t: terms: search.terms }}
        {%- else -%}
          {{ 'search.results_for' | t: terms: search.terms, count: search.results_count }}
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- liquid
          assign product_count = 0
          assign other_count = 0
          for result in search.results
            if result.object_type == 'product'
              assign product_count = product_count | plus: 1
            else
              assign other_count = other_count | plus: 1
            endif
          endfor
        -%}

        <facet-filters class="collection-layout{% if section.settings.enable_filtering == false or search.filters.size == 0 %} collection-layout--no-filters{% endif %}" data-section-id="{{ section.id }}">
          {%- render 'facets',
            results: search,
            section_id: section.id,
            terms: search.terms,
            enable_filtering: section.settings.enable_filtering
          -%}

          <div class="collection-layout__results" id="FacetResults-{{ section.id }}" data-facets-results>
            {%- render 'facets-toolbar',
              results: search,
              section_id: section.id,
              terms: search.terms,
              count: search.results_count,
              enable_sorting: section.settings.enable_sorting
            -%}

            {%- if product_count > 0 -%}
              <h2 class="search-group__title">{{ 'search.products' | t }}</h2>
              <ul class="product-grid" role="list" style="{{ grid_style }}">
                {%- for result in search.results -%}
                  {%- if result.object_type == 'product' -%}
                    <li class="product-grid__item">
                      {%- assign card_id = section.id | append: '-' | append: result.id -%}
                      {%- render 'product-card',
                        card_id: card_id,
                        product: result,
                        show_rating: section.settings.show_rating,
                        button_label: section.settings.card_button_label,
                        sizes: sizes
                      -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if other_count > 0 -%}
              <h2 class="search-group__title">{{ 'search.pages' | t }}</h2>
              <ul class="search-list" role="list">
                {%- for result in search.results -%}
                  {%- unless result.object_type == 'product' -%}
                    <li class="search-list__item">
                      <a class="search-list__link" href="{{ result.url }}">
                        {%- assign result_image = result.image | default: result.featured_image -%}
                        {%- if result_image -%}
                          {{ result_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'search-list__image', widths: '120, 240', sizes: '120px' }}
                        {%- endif -%}
                        <span class="search-list__body">
                          <span class="eyebrow search-list__type">
                            {%- if result.object_type == 'article' -%}{{ 'search.article' | t }}{%- else -%}{{ 'search.page' | t }}{%- endif -%}
                          </span>
                          <span class="search-list__title">{{ result.title | escape }}</span>
                          {%- assign excerpt = result.excerpt | default: result.content | strip_html | truncatewords: 28 -%}
                          {%- if excerpt != blank -%}
                            <span class="search-list__excerpt">{{ excerpt }}</span>
                          {%- endif -%}
                        </span>
                        {%- render 'icon', name: 'arrow-right', class: 'search-list__arrow' -%}
                      </a>
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- render 'pagination', paginate: paginate -%}
          </div>
        </facet-filters>
      {%- endpaginate -%}
    {%- else -%}
      {%- if search.performed -%}
        <p class="search-hint">{{ 'search.no_results_text' | t }}</p>
      {%- endif -%}

      {%- assign popular = section.settings.popular_collection -%}
      {%- assign popular_heading = section.settings.popular_heading -%}
      {%- if popular_heading == blank -%}{%- assign popular_heading = 'search.popular' | t -%}{%- endif -%}
      {%- if popular != blank and popular.products.size > 0 -%}
        <div class="search-popular">
          <h2 class="search-group__title search-popular__title">{{ popular_heading | escape }}</h2>
          <ul class="product-grid product-grid--full" role="list" style="{{ grid_style }} --columns: 4;">
            {%- for product in popular.products limit: 4 -%}
              <li class="product-grid__item">
                {%- assign card_id = section.id | append: '-popular-' | append: product.id -%}
                {%- render 'product-card',
                  card_id: card_id,
                  product: product,
                  show_rating: section.settings.show_rating,
                  button_label: section.settings.card_button_label,
                  sizes: '(min-width: 990px) 25vw, 50vw'
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "main-search-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your glow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Filters apply to products. Customize them in the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "wide", "label": "Landscape (10:7)" },
        { "value": "standard", "label": "Slightly landscape (5:4)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "standard"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Card button label",
      "info": "Leave empty for no button on cards."
    },
    {
      "type": "header",
      "content": "No search / no results"
    },
    {
      "type": "text",
      "id": "popular_heading",
      "label": "Heading",
      "default": "Popular right now"
    },
    {
      "type": "collection",
      "id": "popular_collection",
      "label": "Products from collection",
      "info": "Shown before a search and when a search finds nothing."
    }
  ]
}
{% endschema %}
