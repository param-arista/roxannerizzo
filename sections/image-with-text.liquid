{% comment %}
  "Our story": image beside eyebrow, heading, rich text and a row of short
  columns (Our vision / Our values), each under a bronze rule.
{% endcomment %}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- assign heading_id = 'ImageTextHeading-' | append: section.id -%}

<section
  class="section image-with-text image-with-text--image-{{ section.settings.image_position }}{% if section.settings.alt_background %} section--alt{% endif %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width image-with-text__grid">
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 45vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'image-with-text__placeholder' }}
      {%- endif -%}
    </div>

    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="image-with-text__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="image-with-text__columns" role="list">
          {%- for block in section.blocks -%}
            <li class="image-with-text__column" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="image-with-text__column-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "image-with-text-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Once an industry secret, now available to everyone"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell your brand's story here. Use bold for the line that matters most.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to hide."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "Light grey background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Our vision"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Bringing simplicity back to beauty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "column", "settings": { "title": "Our vision", "text": "Bringing simplicity back to beauty." } },
        { "type": "column", "settings": { "title": "Our values", "text": "Beauty for everyone no color matching ever needed." } }
      ]
    }
  ]
}
{% endschema %}
