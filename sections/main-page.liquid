{% comment %}
  Content page (Shipping, Returns, FAQ, Terms…): the home page's centred
  eyebrow + uppercase title over the page's rich text in a readable column.
{% endcomment %}

{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- assign heading_id = 'PageHeading-' | append: section.id -%}

<section class="section main-page main-page--{{ section.settings.width }}" aria-labelledby="{{ heading_id }}">
  <div class="page-width">
    {%- render 'page-header', eyebrow: section.settings.eyebrow, heading: page.title, id: heading_id -%}
    {%- if page.content != blank -%}
      <div class="main-page__content rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{%- render 'section-spacing', section: section -%}

{% schema %}
{
  "name": "Page content",
  "tag": "div",
  "class": "main-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Roxanne Rizzo"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Text width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow (best for reading)"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 56
    }
  ],
  "enabled_on": {
    "templates": [
      "page"
    ]
  }
}
{% endschema %}
